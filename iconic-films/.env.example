# 로컬: 비워 두면 data/ 폴더에 저장합니다.
# Vercel: 아래 3개를 Vercel 프로젝트 환경 변수에 설정하세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=iconic-media

# 선택: Global Storage 업로드 한도를 사전 확인할 때만 필요합니다.
# Supabase Management API (storage_config_read 권한). 서비스 역할 키와 별개입니다.
# 이 토큰은 Vercel 서버 환경 변수에만 저장하고 공개 사이트나 GitHub에 넣지 마세요.
# SUPABASE_MANAGEMENT_TOKEN=

# 새 설치의 초기 PIN. 관리자에서 변경하면 DB에 저장된 PIN이 우선합니다.
ADMIN_PIN=1211

# 로컬 저장 위치를 바꾸고 싶을 때만 지정하세요.
# ICONIC_DATA_DIR=./data
